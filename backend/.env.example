# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/elg_pos

# DIAN
DIAN_TEST_URL=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc?wsdl
DIAN_PROD_URL=https://vpfe.dian.gov.co/WcfDianCustomerServices.svc?wsdl
DIAN_ENVIRONMENT=mock         # mock | test | prod

# Habilitación DIAN (juego de pruebas y software autorizado)
DIAN_TEST_SET_ID=             # TestSetId del juego de pruebas; vacío => 123456
DIAN_SOFTWARE_ID=             # SoftwareID asignado por la DIAN
DIAN_SOFTWARE_PIN=            # PIN del software (SoftwareSecurityCode)

# Digital Certificate
CERTIFICATE_PATH=/etc/elg/certificates/firma.p12
CERTIFICATE_PASSWORD=your_cert_password

# JWT
JWT_SECRET=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Credenciales de los POS autorizados (las que se cargan en el POS de escritorio).
# Formato: client_id:client_secret separados por coma. Evita ':' y ',' en el secret.
POS_CLIENTS=pos-tienda-1:cambia-este-secreto

# POS Configuration
EMISOR_NIT=1234567890
EMISOR_RAZON_SOCIAL=El G Tienda TCG
EMISOR_NOMBRE_COMERCIAL=El G
EMISOR_DIRECCION=Cra 1 # 2-3
EMISOR_MUNICIPIO=05001
EMISOR_DEPARTAMENTO=05
EMISOR_PAIS=CO
EMISOR_TELEFONO=3001234567
EMISOR_EMAIL=facturacion@elg.com
REGMEN_FISCAL=48-20
